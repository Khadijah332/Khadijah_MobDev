<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View roadworks and traffic incidents near your current location. Tap an update to see more details. Location permission is required to display updates near you."
        android:textSize="16sp"
        android:textColor="#555555"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btnSearchNearby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Press here "
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
      />

    <LinearLayout
        android:id="@+id/nearbyContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distance: 5 km"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/distanceSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="0" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/nearbyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>


</LinearLayout>
